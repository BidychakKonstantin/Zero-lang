nat8 TOK_ND_NUM       = 1
nat8 TOK_ND_CHAR      = 2
nat8 TOK_ND_STRING    = 3
nat8 TOK_ND_IDENT     = 4
nat8 TOK_ND_BOOL      = 5
nat8 TOK_ND_NULL      = 6
nat8 TOK_ND_BINOP     = 7
nat8 TOK_ND_UNARY     = 8
nat8 TOK_ND_CALL      = 9
nat8 TOK_ND_INDEX     = 10
nat8 TOK_ND_ASSIGN    = 11
nat8 TOK_ND_ARRASSIGN = 12
nat8 TOK_ND_VARDECL   = 13
nat8 TOK_ND_ARRDECL   = 14
nat8 TOK_ND_IF        = 15
nat8 TOK_ND_REPCOUNT  = 16
nat8 TOK_ND_REPCOND   = 17
nat8 TOK_ND_RETURN    = 18
nat8 TOK_ND_PARAM     = 19
nat8 TOK_ND_FUNC      = 20
nat8 TOK_ND_PROGRAM   = 21
nat8 TOK_ND_GLOBALVAR = 22
nat8 TOK_ND_LIST      = 23


nat8  ast_kind[65536]
nat64 ast_a[65536]
nat64 ast_b[65536]
nat64 ast_c[65536]
nat64 ast_d[65536]
nat64 ast_name_ptr[65536]
nat64 ast_name_len[65536]
nat64 ast_next[65536]

nat64 ast_count = 0

ast_new_node() -> nat64 {
    ast_count = ast_count + 1
    ret ast_count
}

// ------------------------------------------------------------
// LIST
// ------------------------------------------------------------

ast_list_new() -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_LIST
    ast_a[id] = 0
    ast_d[id] = 0
    ret id
}

ast_list_append(nat64 list_id, nat64 item_id) -> nat64 {
    nat64 tail = ast_d[list_id]
    ast_next[item_id] = 0
    if tail == 0 {
        ast_a[list_id] = item_id
    }
    if tail != 0 {
        ast_next[tail] = item_id
    }
    ast_d[list_id] = item_id
    ret 0
}

ast_list_first(nat64 list_id) -> nat64 {
    ret ast_a[list_id]
}

ast_num(nat64 value) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_NUM
    ast_a[id] = value
    ret id
}

ast_char(nat64 value) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_CHAR
    ast_a[id] = value
    ret id
}

ast_string(chr* ptr, nat64 len) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_STRING
    ast_name_ptr[id] = ptr
    ast_name_len[id] = len
    ret id
}

ast_ident(chr* ptr, nat64 len) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_IDENT
    ast_name_ptr[id] = ptr
    ast_name_len[id] = len
    ret id
}

ast_bool(nat64 v) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_BOOL
    ast_a[id] = v
    ret id
}

ast_null() -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_NULL
    ret id
}

ast_binop(nat64 op, nat64 left, nat64 right) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_BINOP
    ast_a[id] = left
    ast_b[id] = right
    ast_c[id] = op
    ret id
}

ast_unary(nat64 op, nat64 operand) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_UNARY
    ast_a[id] = operand
    ast_c[id] = op
    ret id
}

ast_call(chr* name_ptr, nat64 name_len, nat64 args_list) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_CALL
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ast_a[id] = args_list
    ret id
}

ast_index(chr* name_ptr, nat64 name_len, nat64 index_expr) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_INDEX
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ast_a[id] = index_expr
    ret id
}

ast_assign(chr* name_ptr, nat64 name_len, nat64 value_expr) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_ASSIGN
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ast_a[id] = value_expr
    ret id
}

ast_arrassign(chr* name_ptr, nat64 name_len, nat64 index_expr, nat64 value_expr) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_ARRASSIGN
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ast_a[id] = index_expr
    ast_b[id] = value_expr
    ret id
}

ast_vardecl(nat64 type_tok, nat64 is_ptr, chr* name_ptr, nat64 name_len, nat64 init_expr) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_VARDECL
    ast_a[id] = type_tok
    ast_d[id] = is_ptr
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ast_b[id] = init_expr
    ret id
}

ast_arrdecl(nat64 type_tok, chr* name_ptr, nat64 name_len, nat64 size) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_ARRDECL
    ast_a[id] = type_tok
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ast_d[id] = size
    ret id
}

ast_if(nat64 cond, nat64 then_list, nat64 else_list) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_IF
    ast_a[id] = cond
    ast_b[id] = then_list
    ast_c[id] = else_list
    ret id
}

ast_repcount(nat64 count, nat64 body_list) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_REPCOUNT
    ast_a[id] = count
    ast_b[id] = body_list
    ret id
}

ast_repcond(nat64 cond, nat64 body_list) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_REPCOND
    ast_a[id] = cond
    ast_b[id] = body_list
    ret id
}

ast_return(nat64 expr) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_RETURN
    ast_a[id] = expr
    ret id
}

ast_param(nat64 type_tok, nat64 is_ptr, chr* name_ptr, nat64 name_len) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_PARAM
    ast_a[id] = type_tok
    ast_d[id] = is_ptr
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ret id
}

ast_func(chr* name_ptr, nat64 name_len, nat64 params_list, nat64 body_list, nat64 ret_type, nat64 ret_is_ptr) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_FUNC
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ast_a[id] = params_list
    ast_b[id] = body_list
    ast_c[id] = ret_type
    ast_d[id] = ret_is_ptr
    ret id
}

ast_globalvar(nat64 type_tok, nat64 is_ptr, chr* name_ptr, nat64 name_len) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_GLOBALVAR
    ast_a[id] = type_tok
    ast_d[id] = is_ptr
    ast_name_ptr[id] = name_ptr
    ast_name_len[id] = name_len
    ret id
}

ast_program(nat64 top_list) -> nat64 {
    nat64 id = ast_new_node()
    ast_kind[id] = TOK_ND_PROGRAM
    ast_a[id] = top_list
    ret id
}