use "tokens.zr"
use "std.zr"

nat64 token_value = 0
nat64 token_ptr = 0
nat64 token_len = 0

nat64 lx_cur = 0
nat64 lx_end = 0
nat64 lx_slot = 0
nat64 lx_depth = 0
nat64 lx_file_count = 0
nat64 lx_used_count = 0

nat64 lx_pool[262144]
nat64 lx_dirs[16384]
nat64 lx_dirlen[32]
nat64 lx_used[16384]
nat64 lx_usedlen[32]
nat64 lx_stack_cur[32]
nat64 lx_stack_end[32]
nat64 lx_stack_slot[32]
nat64 lx_path[512]

lx_fail(nat64 msg) -> nat64 {
    err_str("Error: ")
    err_str(msg)
    err_str("\n")
    ret exit_program(1)
}

lx_peek() -> nat64 {
    if lx_cur >= lx_end {
        ret 0
    }
    ret *lx_cur
}

lx_peek_at(nat64 off) -> nat64 {
    nat64 p = lx_cur + off
    if p >= lx_end {
        ret 0
    }
    ret *p
}

lx_adv() -> nat64 {
    nat64 c = lx_peek()
    if lx_cur < lx_end {
        lx_cur = lx_cur + 1
    }
    ret c
}

lx_is_digit(nat64 c) -> nat64 {
    ret c >= 48 && c <= 57
}

lx_is_alpha(nat64 c) -> nat64 {
    ret (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
}

lx_is_alnum(nat64 c) -> nat64 {
    ret lx_is_alpha(c) == 1 || lx_is_digit(c) == 1
}

lx_skip() -> nat64 {
    rep true {
        nat64 c = lx_peek()
        if c == 32 || c == 9 || c == 13 {
            lx_adv()
        } else {
            if c == 47 && lx_peek_at(1) == 47 {
                rep lx_peek() != 10 && lx_peek() != 0 {
                    lx_adv()
                }
            } else {
                ret 0
            }
        }
    }
    ret 0
}

lx_tok(nat64 t, nat64 start, nat64 len) -> nat64 {
    token_ptr = start
    token_len = len
    ret t
}

lx_kw(nat64 p, nat64 n, nat64 s, nat64 sn) -> nat64 {
    if n != sn {
        ret 0
    }
    nat64 i = 0
    rep i != n {
        if *(p + i) != *(s + i) {
            ret 0
        }
        i = i + 1
    }
    ret 1
}

lx_keyword(nat64 p, nat64 n) -> nat64 {
    if lx_kw(p, n, "if", 2) == 1 {
        ret TOK_IF
    }
    if lx_kw(p, n, "else", 4) == 1 {
        ret TOK_ELSE
    }
    if lx_kw(p, n, "rep", 3) == 1 {
        ret TOK_REP
    }
    if lx_kw(p, n, "ret", 3) == 1 {
        ret TOK_RET
    }
    if lx_kw(p, n, "use", 3) == 1 {
        ret TOK_USE
    }
    if lx_kw(p, n, "chr", 3) == 1 {
        ret TOK_CHR
    }
    if lx_kw(p, n, "bool", 4) == 1 {
        ret TOK_BOOL
    }
    if lx_kw(p, n, "NULL", 4) == 1 {
        ret TOK_NULL
    }
    if lx_kw(p, n, "int8", 4) == 1 {
        ret TOK_INT8
    }
    if lx_kw(p, n, "nat8", 4) == 1 {
        ret TOK_NAT8
    }
    if lx_kw(p, n, "int16", 5) == 1 {
        ret TOK_INT16
    }
    if lx_kw(p, n, "nat16", 5) == 1 {
        ret TOK_NAT16
    }
    if lx_kw(p, n, "int32", 5) == 1 {
        ret TOK_INT32
    }
    if lx_kw(p, n, "nat32", 5) == 1 {
        ret TOK_NAT32
    }
    if lx_kw(p, n, "int64", 5) == 1 {
        ret TOK_INT64
    }
    if lx_kw(p, n, "nat64", 5) == 1 {
        ret TOK_NAT64
    }
    ret TOK_IDENT
}

lx_single(nat64 c) -> nat64 {
    if c == 10 {
        ret TOK_NEWLINE
    }
    if c == '{' {
        ret TOK_LBRACE
    }
    if c == '}' {
        ret TOK_RBRACE
    }
    if c == '(' {
        ret TOK_LPAREN
    }
    if c == ')' {
        ret TOK_RPAREN
    }
    if c == '[' {
        ret TOK_LBRACK
    }
    if c == ']' {
        ret TOK_RBRACK
    }
    if c == ',' {
        ret TOK_COMMA
    }
    if c == '+' {
        ret TOK_PLUS
    }
    if c == '*' {
        ret TOK_STAR
    }
    if c == '/' {
        ret TOK_SLASH
    }
    ret 0
}

lx_pop() -> nat64 {
    lx_depth = lx_depth - 1
    lx_cur = lx_stack_cur[lx_depth]
    lx_end = lx_stack_end[lx_depth]
    lx_slot = lx_stack_slot[lx_depth]
    ret 0
}

lexer_next_token() -> nat64 {
    lx_skip()
    if lx_cur >= lx_end {
        if lx_depth == 0 {
            ret TOK_EOF
        }
        lx_pop()
        ret lexer_next_token()
    }
    nat64 start = lx_cur
    nat64 c = lx_adv()

    nat64 st = lx_single(c)
    if st != 0 {
        ret lx_tok(st, start, 1)
    }

    if c == '=' {
        if lx_peek() == '=' {
            lx_adv()
            ret lx_tok(TOK_EQEQ, start, 2)
        }
        ret lx_tok(TOK_EQUAL, start, 1)
    }
    if c == '-' {
        if lx_peek() == '>' {
            lx_adv()
            ret lx_tok(TOK_ARROW, start, 2)
        }
        ret lx_tok(TOK_MINUS, start, 1)
    }
    if c == '<' {
        if lx_peek() == '=' {
            lx_adv()
            ret lx_tok(TOK_LTE, start, 2)
        }
        ret lx_tok(TOK_LT, start, 1)
    }
    if c == '>' {
        if lx_peek() == '=' {
            lx_adv()
            ret lx_tok(TOK_GTE, start, 2)
        }
        ret lx_tok(TOK_GT, start, 1)
    }
    if c == '!' {
        if lx_peek() == '=' {
            lx_adv()
            ret lx_tok(TOK_NOTEQ, start, 2)
        }
        ret lx_tok(TOK_UNKNOWN, start, 1)
    }
    if c == '&' {
        if lx_peek() == '&' {
            lx_adv()
            ret lx_tok(TOK_ANDAND, start, 2)
        }
        ret lx_tok(TOK_AMP, start, 1)
    }
    if c == '|' {
        if lx_peek() == '|' {
            lx_adv()
            ret lx_tok(TOK_OROR, start, 2)
        }
        ret lx_tok(TOK_UNKNOWN, start, 1)
    }

    if lx_is_digit(c) == 1 {
        nat64 v = c - 48
        rep lx_is_digit(lx_peek()) == 1 {
            v = v * 10 + (lx_adv() - 48)
        }
        token_value = v
        ret lx_tok(TOK_NUMBER, start, lx_cur - start)
    }

    if c == 39 {
        nat64 ch = lx_adv()
        if ch == 92 {
            nat64 e = lx_adv()
            ch = e
            if e == 'n' {
                ch = 10
            }
            if e == 't' {
                ch = 9
            }
            if e == 'r' {
                ch = 13
            }
            if e == '0' {
                ch = 0
            }
        }
        lx_adv()
        token_value = ch
        ret lx_tok(TOK_CHAR, start, lx_cur - start)
    }

    if c == 34 {
        nat64 sstart = lx_cur
        rep lx_peek() != 34 && lx_peek() != 0 {
            if lx_peek() == 92 {
                lx_adv()
            }
            lx_adv()
        }
        nat64 slen = lx_cur - sstart
        lx_adv()
        ret lx_tok(TOK_STRING, sstart, slen)
    }

    if lx_is_alpha(c) == 1 {
        rep lx_is_alnum(lx_peek()) == 1 {
            lx_adv()
        }
        nat64 ilen = lx_cur - start
        ret lx_tok(lx_keyword(start, ilen), start, ilen)
    }

    ret lx_tok(TOK_UNKNOWN, start, 1)
}

lx_copy_to_path(nat64 src, nat64 n, nat64 at) -> nat64 {
    nat64 i = 0
    rep i != n {
        poke8(&lx_path + at + i, *(src + i))
        i = i + 1
    }
    ret at + n
}

lx_find_used(nat64 n) -> nat64 {
    nat64 k = 0
    rep k != lx_used_count {
        if lx_usedlen[k] == n {
            nat64 base = &lx_used + k * 4096
            nat64 i = 0
            nat64 same = 1
            rep i != n {
                if *(base + i) != *(&lx_path + i) {
                    same = 0
                }
                i = i + 1
            }
            if same == 1 {
                ret 1
            }
        }
        k = k + 1
    }
    ret 0
}

lx_record_used(nat64 n) -> nat64 {
    nat64 base = &lx_used + lx_used_count * 4096
    nat64 i = 0
    rep i != n {
        poke8(base + i, *(&lx_path + i))
        i = i + 1
    }
    lx_usedlen[lx_used_count] = n
    lx_used_count = lx_used_count + 1
    ret 0
}

lx_set_dir(nat64 slot, nat64 n) -> nat64 {
    nat64 i = 0
    nat64 dl = 0
    rep i != n {
        if *(&lx_path + i) == '/' {
            dl = i + 1
        }
        i = i + 1
    }
    nat64 dbase = &lx_dirs + slot * 4096
    i = 0
    rep i != dl {
        poke8(dbase + i, *(&lx_path + i))
        i = i + 1
    }
    lx_dirlen[slot] = dl
    ret 0
}

lx_load(nat64 n) -> nat64 {
    poke8(&lx_path + n, 0)
    if lx_find_used(n) == 1 {
        ret 1
    }
    if lx_file_count >= 31 || lx_depth >= 31 {
        lx_fail("too many source files")
    }
    lx_record_used(n)
    nat64 slot = lx_file_count
    lx_file_count = lx_file_count + 1
    nat64 base = &lx_pool + slot * 65536
    nat64 got = read_file(&lx_path, base, 65535)
    if got > 65535 {
        lx_fail("cannot open source file")
    }
    poke8(base + got, 0)
    lx_stack_cur[lx_depth] = lx_cur
    lx_stack_end[lx_depth] = lx_end
    lx_stack_slot[lx_depth] = lx_slot
    lx_depth = lx_depth + 1
    lx_cur = base
    lx_end = base + got
    lx_slot = slot
    lx_set_dir(slot, n)
    ret 1
}

lexer_open(nat64 path) -> nat64 {
    nat64 n = str_len(path)
    lx_copy_to_path(path, n, 0)
    ret lx_load(n)
}

lexer_use_file(nat64 p, nat64 n) -> nat64 {
    nat64 at = 0
    if *p != '/' {
        at = lx_copy_to_path(&lx_dirs + lx_slot * 4096, lx_dirlen[lx_slot], 0)
    }
    at = lx_copy_to_path(p, n, at)
    ret lx_load(at)
}