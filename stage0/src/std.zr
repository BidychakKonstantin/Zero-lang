use "tokens.zr"

nat64 pu_buf[4]

str_len(nat64 s) -> nat64 {
    nat64 n = 0
    rep *(s + n) != 0 {
        n = n + 1
    }
    ret n
}

write_str(nat64 s) -> nat64 {
    ret write_bytes(s, str_len(s))
}

err_str(nat64 s) -> nat64 {
    ret write_err(s, str_len(s))
}

emit_nl() -> nat64 {
    nat64 c = 10
    ret write_bytes(&c, 1)
}

print_uint(nat64 n) -> nat64 {
    nat64 pos = 32
    if n == 0 {
        pos = pos - 1
        poke8(&pu_buf + pos, 48)
    }
    rep n != 0 {
        pos = pos - 1
        poke8(&pu_buf + pos, n - (n / 10) * 10 + 48)
        n = n / 10
    }
    ret write_bytes(&pu_buf + pos, 32 - pos)
}

exit_program(nat64 code) -> nat64 {
    ret syscall2(60, code)
}