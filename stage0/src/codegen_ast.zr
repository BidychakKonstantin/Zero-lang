use tokens
use std
use ast

nat64 loc_name_ptr[1024]
nat64 loc_name_len[1024]
nat64 loc_off[1024]
nat64 loc_type[1024]
nat64 loc_ptr[1024]
nat64 loc_arr[1024]
nat64 loc_count = 0

nat64 glb_name_ptr[1024]
nat64 glb_name_len[1024]
nat64 glb_type[1024]
nat64 glb_ptr[1024]
nat64 glb_arr[1024]
nat64 glb_count = 0

nat64 con_name_ptr[1024]
nat64 con_name_len[1024]
nat64 con_value[1024]
nat64 con_count = 0

nat64 nib_ptr[256]
nat64 nib_len[256]
nat64 nib_sgn[256]
nat64 nib_count = 0
nat64 nib_global = 0

nat64 cg_label = 0
nat64 cg_fn = 0
nat64 cg_frame = 0
nat64 cg_nest = 0
nat64 cg_has_ret = 0
nat64 cg_str = 0
nat64 cg_ret_type = 0
nat64 cg_ret_ptr = 0

// result of sym_lookup
nat64 sy_type = 0
nat64 sy_ptr = 0
nat64 sy_arr = 0

ln(nat64 s) -> nat64 {
    write_str(s)
    ret emit_nl()
}

lab(nat64 s, nat64 n) -> nat64 {
    write_str(s)
    ret print_uint(n)
}

labln(nat64 s, nat64 n) -> nat64 {
    lab(s, n)
    ret emit_nl()
}

labdef(nat64 s, nat64 n) -> nat64 {
    lab(s, n)
    ret ln(":")
}

str_eq(nat64 a, nat64 an, nat64 b, nat64 bn) -> nat64 {
    if an != bn {
        ret 0
    }
    nat64 i = 0
    rep i != an {
        if *(a + i) != *(b + i) {
            ret 0
        }
        i = i + 1
    }
    ret 1
}

// ------------------------------------------------------------
// TYPE WIDTHS: size in bytes follows the type name
// ------------------------------------------------------------

type_size(nat64 t, nat64 isptr) -> nat64 {
    if isptr == 1 {
        ret 8
    }
    if t == TOK_INT8 || t == TOK_NAT8 || t == TOK_CHR || t == TOK_BOOL {
        ret 1
    }
    if t == TOK_INT4 || t == TOK_NAT4 {
        ret 1
    }
    if t == TOK_INT16 || t == TOK_NAT16 {
        ret 2
    }
    if t == TOK_INT32 || t == TOK_NAT32 {
        ret 4
    }
    ret 8
}

type_signed(nat64 t, nat64 isptr) -> nat64 {
    if isptr == 1 {
        ret 0
    }
    if t == TOK_INT8 || t == TOK_INT16 || t == TOK_INT32 {
        ret 1
    }
    ret 0
}

size_kw(nat64 sz) -> nat64 {
    if sz == 1 {
        ret write_str("byte")
    }
    if sz == 2 {
        ret write_str("word")
    }
    if sz == 4 {
        ret write_str("dword")
    }
    ret write_str("QWORD")
}

emit_ax(nat64 sz) -> nat64 {
    if sz == 1 {
        ret write_str("al")
    }
    if sz == 2 {
        ret write_str("ax")
    }
    if sz == 4 {
        ret write_str("eax")
    }
    ret write_str("rax")
}

emit_r12(nat64 sz) -> nat64 {
    if sz == 1 {
        ret write_str("r12b")
    }
    if sz == 2 {
        ret write_str("r12w")
    }
    if sz == 4 {
        ret write_str("r12d")
    }
    ret write_str("r12")
}

// writes "mov rax, <size> [" (zero/sign extended), caller writes address and "]"
load_prefix(nat64 sz, nat64 sg) -> nat64 {
    if sz == 8 {
        ret write_str("    mov rax, QWORD [")
    }
    if sz == 4 {
        if sg == 1 {
            ret write_str("    movsxd rax, dword [")
        }
        ret write_str("    mov eax, dword [")
    }
    if sz == 2 {
        if sg == 1 {
            ret write_str("    movsx rax, word [")
        }
        ret write_str("    movzx rax, word [")
    }
    if sg == 1 {
        ret write_str("    movsx rax, byte [")
    }
    ret write_str("    movzx rax, byte [")
}

norm_after_load(nat64 t, nat64 isptr) -> nat64 {
    if isptr == 1 {
        ret 0
    }
    if t == TOK_NAT4 {
        ret ln("    and rax, 15")
    }
    if t == TOK_INT4 {
        ln("    shl rax, 60")
        ret ln("    sar rax, 60")
    }
    ret 0
}

// ------------------------------------------------------------
// SYMBOL TABLES
// ------------------------------------------------------------

loc_find(nat64 p, nat64 n) -> nat64 {
    nat64 i = loc_count
    rep i != 0 {
        i = i - 1
        if str_eq(loc_name_ptr[i], loc_name_len[i], p, n) == 1 {
            ret i + 1
        }
    }
    ret 0
}

loc_add(nat64 p, nat64 n, nat64 slots, nat64 t, nat64 pt, nat64 arr) -> nat64 {
    cg_frame = cg_frame + slots * 8
    loc_name_ptr[loc_count] = p
    loc_name_len[loc_count] = n
    loc_off[loc_count] = cg_frame
    loc_type[loc_count] = t
    loc_ptr[loc_count] = pt
    loc_arr[loc_count] = arr
    loc_count = loc_count + 1
    ret cg_frame
}

glb_find(nat64 p, nat64 n) -> nat64 {
    nat64 i = glb_count
    rep i != 0 {
        i = i - 1
        if str_eq(glb_name_ptr[i], glb_name_len[i], p, n) == 1 {
            ret i + 1
        }
    }
    ret 0
}

glb_add(nat64 p, nat64 n, nat64 t, nat64 pt, nat64 arr) -> nat64 {
    glb_name_ptr[glb_count] = p
    glb_name_len[glb_count] = n
    glb_type[glb_count] = t
    glb_ptr[glb_count] = pt
    glb_arr[glb_count] = arr
    glb_count = glb_count + 1
    ret 0
}

// locals shadow globals; fills sy_type / sy_ptr / sy_arr, returns 1 if found
sym_lookup(nat64 p, nat64 n) -> nat64 {
    nat64 li = loc_find(p, n)
    if li != 0 {
        sy_type = loc_type[li - 1]
        sy_ptr = loc_ptr[li - 1]
        sy_arr = loc_arr[li - 1]
        ret 1
    }
    nat64 gi = glb_find(p, n)
    if gi != 0 {
        sy_type = glb_type[gi - 1]
        sy_ptr = glb_ptr[gi - 1]
        sy_arr = glb_arr[gi - 1]
        ret 1
    }
    ret 0
}

con_find(nat64 p, nat64 n) -> nat64 {
    nat64 i = con_count
    rep i != 0 {
        i = i - 1
        if str_eq(con_name_ptr[i], con_name_len[i], p, n) == 1 {
            ret i + 1
        }
    }
    ret 0
}

con_add(nat64 p, nat64 n, nat64 v) -> nat64 {
    con_name_ptr[con_count] = p
    con_name_len[con_count] = n
    con_value[con_count] = v
    con_count = con_count + 1
    ret 0
}

nib_find(nat64 p, nat64 n) -> nat64 {
    nat64 i = nib_count
    rep i != 0 {
        i = i - 1
        if str_eq(nib_ptr[i], nib_len[i], p, n) == 1 {
            ret i + 1
        }
    }
    ret 0
}

nib_add(nat64 p, nat64 n, nat64 sgn) -> nat64 {
    nib_ptr[nib_count] = p
    nib_len[nib_count] = n
    nib_sgn[nib_count] = sgn
    nib_count = nib_count + 1
    ret 0
}

is_nib_type(nat64 t) -> nat64 {
    ret t == TOK_NAT4 || t == TOK_INT4
}

const_eval(nat64 node) -> nat64 {
    nat64 k = ast_kind[node]
    if k == TOK_ND_NUM {
        ret ast_a[node]
    }
    if k == TOK_ND_CHAR {
        ret ast_a[node]
    }
    if k == TOK_ND_IDENT {
        nat64 ci = con_find(ast_name_ptr[node], ast_name_len[node])
        if ci != 0 {
            ret con_value[ci - 1]
        }
    }
    ret 0
}

emit_var(nat64 p, nat64 n) -> nat64 {
    nat64 li = loc_find(p, n)
    if li == 0 {
        ret write_bytes(p, n)
    }
    write_str("rbp - ")
    ret print_uint(loc_off[li - 1])
}

argreg(nat64 i) -> nat64 {
    if i == 0 {
        ret write_str("rdi")
    }
    if i == 1 {
        ret write_str("rsi")
    }
    if i == 2 {
        ret write_str("rdx")
    }
    if i == 3 {
        ret write_str("rcx")
    }
    if i == 4 {
        ret write_str("r8")
    }
    ret write_str("r9")
}

gen_pop_args(nat64 count) -> nat64 {
    nat64 i = count
    rep i != 0 {
        i = i - 1
        ln("    pop rax")
        write_str("    mov ")
        argreg(i)
        ln(", rax")
    }
    ret 0
}

gen_cmp(nat64 s) -> nat64 {
    ln("    pop rbx")
    ln("    cmp rbx, rax")
    write_str("    ")
    write_str(s)
    ln(" al")
    ret ln("    movzx rax, al")
}

gen_binop_tail(nat64 op) -> nat64 {
    if op == TOK_PLUS {
        ln("    pop rbx")
        ret ln("    add rax, rbx")
    }
    if op == TOK_MINUS {
        ln("    pop rbx")
        ln("    mov rcx, rax")
        ln("    mov rax, rbx")
        ret ln("    sub rax, rcx")
    }
    if op == TOK_STAR {
        ln("    pop rbx")
        ret ln("    imul rax, rbx")
    }
    if op == TOK_SLASH {
        ln("    pop rbx")
        ln("    xchg rax, rbx")
        ln("    xor rdx, rdx")
        ret ln("    div rbx")
    }
    if op == TOK_EQEQ {
        ret gen_cmp("sete")
    }
    if op == TOK_NOTEQ {
        ret gen_cmp("setne")
    }
    if op == TOK_LT {
        ret gen_cmp("setl")
    }
    if op == TOK_GT {
        ret gen_cmp("setg")
    }
    if op == TOK_LTE {
        ret gen_cmp("setle")
    }
    if op == TOK_GTE {
        ret gen_cmp("setge")
    }
    if op == TOK_ANDAND {
        ln("    pop rbx")
        ln("    test rax, rax")
        ln("    setne al")
        ln("    test rbx, rbx")
        ln("    setne bl")
        ln("    and al, bl")
        ret ln("    movzx rax, al")
    }
    if op == TOK_OROR {
        ln("    pop rbx")
        ln("    or rax, rbx")
        ln("    test rax, rax")
        ln("    setne al")
        ret ln("    movzx rax, al")
    }
    if op == TOK_REMAINDER {
        ln("    pop rbx")
        ln("    xchg rax, rbx")
        ln("    xor rdx, rdx")
        ln("    div rbx")
        ret ln("    mov rax, rdx")
    }
    ret 0
}

gen_string(nat64 node) -> nat64 {
    nat64 idx = cg_str
    cg_str = cg_str + 1
    ln("section .rodata")
    lab("str_", idx)
    write_str(": db ")
    nat64 p = ast_name_ptr[node]
    nat64 n = ast_name_len[node]
    nat64 i = 0
    rep i < n {
        nat64 c = *(p + i)
        if c == 92 {
            i = i + 1
            nat64 e = *(p + i)
            c = e
            if e == 'n' {
                c = 10
            }
            if e == 't' {
                c = 9
            }
            if e == 'r' {
                c = 13
            }
            if e == '0' {
                c = 0
            }
        }
        print_uint(c)
        write_str(", ")
        i = i + 1
    }
    ln("0")
    ln("section .text")
    lab("    lea rax, [rel str_", idx)
    ret ln("]")
}

gen_print() -> nat64 {
    nat64 lb = cg_label
    cg_label = cg_label + 1
    ln("    sub rsp, 32")
    ln("    mov r8, rsp")
    ln("    add r8, 31")
    ln("    mov byte [r8], 10")
    ln("    mov r9, r8")
    ln("    test rax, rax")
    labln("    jnz L_pr_c_", lb)
    ln("    dec r8")
    ln("    mov byte [r8], '0'")
    labln("    jmp L_pr_o_", lb)
    labdef("L_pr_c_", lb)
    ln("    mov r10, 10")
    labdef("L_pr_l_", lb)
    ln("    test rax, rax")
    labln("    jz L_pr_o_", lb)
    ln("    xor rdx, rdx")
    ln("    div r10")
    ln("    add dl, '0'")
    ln("    dec r8")
    ln("    mov [r8], dl")
    labln("    jmp L_pr_l_", lb)
    labdef("L_pr_o_", lb)
    ln("    mov eax, 1")
    ln("    mov edi, 1")
    ln("    mov rsi, r8")
    ln("    mov rdx, r9")
    ln("    inc rdx")
    ln("    sub rdx, r8")
    ln("    syscall")
    ret ln("    add rsp, 32")
}

gen_call(nat64 node) -> nat64 {
    if str_eq(ast_name_ptr[node], ast_name_len[node], "print", 5) == 1 {
        nat64 first = ast_list_first(ast_a[node])
        if first == 0 {
            ln("    mov rax, 0")
        }
        if first != 0 {
            gen_expr(first)
        }
        ret gen_print()
    }
    nat64 cur = ast_list_first(ast_a[node])
    nat64 count = 0
    rep cur != 0 {
        gen_expr(cur)
        ln("    push rax")
        count = count + 1
        cur = ast_next[cur]
    }
    gen_pop_args(count)
    write_str("    call ")
    write_bytes(ast_name_ptr[node], ast_name_len[node])
    ret emit_nl()
}

gen_nib_load(nat64 node, nat64 nb) -> nat64 {
    gen_expr(ast_a[node])
    ln("    mov r11, rax")
    ln("    shr rax, 1")
    write_str("    movzx rax, byte [")
    emit_var(ast_name_ptr[node], ast_name_len[node])
    ln(" + rax]")
    ln("    mov rcx, r11")
    ln("    and rcx, 1")
    ln("    shl rcx, 2")
    ln("    shr rax, cl")
    if nib_sgn[nb - 1] == 1 {
        ln("    shl rax, 60")
        ret ln("    sar rax, 60")
    }
    ret ln("    and rax, 15")
}

gen_nib_store(nat64 node) -> nat64 {
    gen_expr(ast_a[node])
    ln("    push rax")
    gen_expr(ast_b[node])
    ln("    mov r12, rax")
    ln("    pop r11")
    ln("    mov rcx, r11")
    ln("    and rcx, 1")
    ln("    shl rcx, 2")
    ln("    mov rdx, r11")
    ln("    shr rdx, 1")
    ln("    and r12, 15")
    ln("    mov rbx, 15")
    ln("    shl rbx, cl")
    ln("    not rbx")
    ln("    shl r12, cl")
    write_str("    movzx rax, byte [")
    emit_var(ast_name_ptr[node], ast_name_len[node])
    ln(" + rdx]")
    ln("    and rax, rbx")
    ln("    or rax, r12")
    write_str("    mov byte [")
    emit_var(ast_name_ptr[node], ast_name_len[node])
    ret ln(" + rdx], al")
}

gen_expr(nat64 node) -> nat64 {
    nat64 kind = ast_kind[node]

    if kind == TOK_ND_NUM || kind == TOK_ND_CHAR || kind == TOK_ND_BOOL {
        write_str("    mov rax, ")
        print_uint(ast_a[node])
        ret emit_nl()
    }
    if kind == TOK_ND_NULL {
        ret ln("    mov rax, 0")
    }
    if kind == TOK_ND_STRING {
        ret gen_string(node)
    }
    if kind == TOK_ND_IDENT {
        nat64 ip = ast_name_ptr[node]
        nat64 il = ast_name_len[node]
        nat64 li = loc_find(ip, il)
        nat64 ci = con_find(ip, il)
        if li == 0 && ci != 0 {
            write_str("    mov rax, ")
            print_uint(con_value[ci - 1])
            ret emit_nl()
        }
        nat64 sz = 8
        nat64 sg = 0
        nat64 found = sym_lookup(ip, il)
        if found == 1 {
            sz = type_size(sy_type, sy_ptr)
            sg = type_signed(sy_type, sy_ptr)
        }
        nat64 vt = sy_type
        nat64 vp = sy_ptr
        load_prefix(sz, sg)
        emit_var(ip, il)
        ln("]")
        if found == 1 {
            norm_after_load(vt, vp)
        }
        ret 0
    }
    if kind == TOK_ND_INDEX {
        nat64 xp = ast_name_ptr[node]
        nat64 xl = ast_name_len[node]
        nat64 nb = nib_find(xp, xl)
        if nb != 0 {
            ret gen_nib_load(node, nb)
        }
        gen_expr(ast_a[node])
        ln("    mov r11, rax")
        nat64 esz = 8
        nat64 esg = 0
        nat64 ety = 0
        nat64 fnd = sym_lookup(xp, xl)
        if fnd == 1 {
            ety = sy_type
            esz = type_size(sy_type, 0)
            esg = type_signed(sy_type, 0)
        }
        load_prefix(esz, esg)
        emit_var(xp, xl)
        write_str(" + r11 * ")
        print_uint(esz)
        ln("]")
        if fnd == 1 {
            norm_after_load(ety, 0)
        }
        ret 0
    }
    if kind == TOK_ND_UNARY {
        if ast_c[node] == TOK_STAR {
            gen_expr(ast_a[node])
            ret ln("    movzx rax, byte [rax]")
        }
        nat64 opd = ast_a[node]
        write_str("    lea rax, [")
        emit_var(ast_name_ptr[opd], ast_name_len[opd])
        ret ln("]")
    }
    if kind == TOK_ND_BINOP {
        gen_expr(ast_a[node])
        ln("    push rax")
        gen_expr(ast_b[node])
        ret gen_binop_tail(ast_c[node])
    }
    if kind == TOK_ND_CALL {
        ret gen_call(node)
    }
    ret 0
}

gen_truncate() -> nat64 {
    if cg_ret_ptr == 1 {
        ret 0
    }
    nat64 t = cg_ret_type
    if t == TOK_NAT4 {
        ln("    and rax, 15")
    }
    if t == TOK_INT4 {
        ln("    shl rax, 60")
        ln("    sar rax, 60")
    }
    if t == TOK_INT8 {
        ln("    movsx rax, al")
    }
    if t == TOK_NAT8 || t == TOK_CHR || t == TOK_BOOL {
        ln("    movzx rax, al")
    }
    if t == TOK_INT16 {
        ln("    movsx rax, ax")
    }
    if t == TOK_NAT16 {
        ln("    movzx rax, ax")
    }
    if t == TOK_INT32 {
        ln("    cdqe")
    }
    if t == TOK_NAT32 {
        ln("    mov eax, eax")
    }
    ret 0
}

gen_stmt(nat64 node) -> nat64 {
    nat64 kind = ast_kind[node]

    if kind == TOK_ND_VARDECL {
        nat64 vt = ast_a[node]
        nat64 vp = ast_d[node]
        nat64 off = loc_add(ast_name_ptr[node], ast_name_len[node], 1, vt, vp, 0)
        gen_expr(ast_b[node])
        nat64 vsz = type_size(vt, vp)
        write_str("    mov ")
        size_kw(vsz)
        write_str(" [rbp - ")
        print_uint(off)
        write_str("], ")
        emit_ax(vsz)
        ret emit_nl()
    }
    if kind == TOK_ND_ARRDECL {
        nat64 at = ast_a[node]
        nat64 cnt = ast_d[node]
        nat64 slots = 0
        if is_nib_type(at) == 1 {
            slots = (cnt + 15) / 16
            nib_add(ast_name_ptr[node], ast_name_len[node], at == TOK_INT4)
        } else {
            slots = (cnt * type_size(at, 0) + 7) / 8
        }
        loc_add(ast_name_ptr[node], ast_name_len[node], slots, at, 0, 1)
        ret 0
    }
    if kind == TOK_ND_PTRASSIGN {
        gen_expr(ast_a[node])
        ln("    push rax")
        gen_expr(ast_b[node])
        ln("    pop rbx")
        ret ln("    mov byte [rbx], al")
    }
    if kind == TOK_ND_ASSIGN {
        gen_expr(ast_a[node])
        nat64 ap = ast_name_ptr[node]
        nat64 al = ast_name_len[node]
        nat64 asz = 8
        if sym_lookup(ap, al) == 1 {
            asz = type_size(sy_type, sy_ptr)
        }
        write_str("    mov ")
        size_kw(asz)
        write_str(" [")
        emit_var(ap, al)
        write_str("], ")
        emit_ax(asz)
        ret emit_nl()
    }
    if kind == TOK_ND_ARRASSIGN {
        nat64 rp = ast_name_ptr[node]
        nat64 rl = ast_name_len[node]
        if nib_find(rp, rl) != 0 {
            ret gen_nib_store(node)
        }
        gen_expr(ast_a[node])
        ln("    push rax")
        gen_expr(ast_b[node])
        ln("    mov r12, rax")
        ln("    pop r11")
        nat64 rsz = 8
        if sym_lookup(rp, rl) == 1 {
            rsz = type_size(sy_type, 0)
        }
        write_str("    mov ")
        size_kw(rsz)
        write_str(" [")
        emit_var(rp, rl)
        write_str(" + r11 * ")
        print_uint(rsz)
        write_str("], ")
        emit_r12(rsz)
        ret emit_nl()
    }
    if kind == TOK_ND_IF {
        gen_expr(ast_a[node])
        nat64 lb = cg_label
        cg_label = cg_label + 1
        ln("    test rax, rax")
        labln("    jz L_if_else_", lb)
        cg_nest = cg_nest + 1
        gen_block(ast_b[node])
        if ast_c[node] != 0 {
            labln("    jmp L_if_end_", lb)
            labdef("L_if_else_", lb)
            gen_block(ast_c[node])
        } else {
            labdef("L_if_else_", lb)
        }
        cg_nest = cg_nest - 1
        ret labdef("L_if_end_", lb)
    }
    if kind == TOK_ND_REPCOUNT {
        nat64 lb = cg_label
        cg_label = cg_label + 1
        write_str("    mov rax, ")
        print_uint(ast_a[node])
        emit_nl()
        ln("    push rax")
        labdef("L_rep_start_", lb)
        ln("    cmp qword [rsp], 0")
        labln("    jle L_rep_end_", lb)
        cg_nest = cg_nest + 1
        gen_block(ast_b[node])
        cg_nest = cg_nest - 1
        ln("    dec qword [rsp]")
        labln("    jmp L_rep_start_", lb)
        labdef("L_rep_end_", lb)
        ret ln("    add rsp, 8")
    }
    if kind == TOK_ND_REPCOND {
        nat64 lb = cg_label
        cg_label = cg_label + 1
        labdef("L_rep_start_", lb)
        gen_expr(ast_a[node])
        ln("    test rax, rax")
        labln("    jz L_rep_end_", lb)
        cg_nest = cg_nest + 1
        gen_block(ast_b[node])
        cg_nest = cg_nest - 1
        labln("    jmp L_rep_start_", lb)
        ret labdef("L_rep_end_", lb)
    }
    if kind == TOK_ND_RETURN {
        if ast_a[node] == 0 {
            ln("    mov rax, 0")
        } else {
            gen_expr(ast_a[node])
        }
        gen_truncate()
        ln("    leave")
        ln("    ret")
        if cg_nest == 0 {
            cg_has_ret = 1
        }
        ret 0
    }
    ret gen_expr(node)
}

gen_block(nat64 list_id) -> nat64 {
    nat64 cur = ast_list_first(list_id)
    rep cur != 0 {
        gen_stmt(cur)
        cur = ast_next[cur]
    }
    ret 0
}

gen_func(nat64 f) -> nat64 {
    cg_fn = cg_fn + 1
    cg_frame = 0
    loc_count = 0
    nib_count = nib_global
    cg_has_ret = 0
    cg_nest = 0
    cg_ret_type = ast_c[f]
    cg_ret_ptr = ast_d[f]
    write_bytes(ast_name_ptr[f], ast_name_len[f])
    ln(":")
    ln("    push rbp")
    ln("    mov rbp, rsp")
    labln("    sub rsp, strict dword FRAME_", cg_fn)
    nat64 cur = ast_list_first(ast_a[f])
    nat64 idx = 0
    rep cur != 0 {
        nat64 off = loc_add(ast_name_ptr[cur], ast_name_len[cur], 1, ast_a[cur], ast_d[cur], 0)
        write_str("    mov rax, ")
        argreg(idx)
        emit_nl()
        write_str("    mov QWORD [rbp - ")
        print_uint(off)
        ln("], rax")
        idx = idx + 1
        cur = ast_next[cur]
    }
    gen_block(ast_b[f])
    if cg_has_ret == 0 {
        ln("    mov rax, 0")
        ln("    leave")
        ln("    ret")
    }
    lab("FRAME_", cg_fn)
    write_str(" equ ")
    print_uint((cg_frame + 15) / 16 * 16)
    ret emit_nl()
}

// reserves exactly `bytes` bytes (8-byte aligned)
gen_global(nat64 node, nat64 bytes) -> nat64 {
    ln("section .bss")
    ln("alignb 8")
    write_bytes(ast_name_ptr[node], ast_name_len[node])
    write_str(": resb ")
    print_uint(bytes)
    emit_nl()
    ret ln("section .text")
}

gen_program(nat64 prog) -> nat64 {
    ln("default rel")
    ln("")
    ln("extern write_bytes")
    ln("extern write_err")
    ln("extern syscall2")
    ln("extern read_file")
    ln("extern get_arg")
    ln("extern arg_count")
    ln("extern runtime_init")
    ln("extern poke8")
    ln("")
    ln("global _start")
    ln("_start:")
    ln("    mov rdi, rsp")
    ln("    call runtime_init")
    ln("    call main")
    ln("    mov edi, eax")
    ln("    mov eax, 60")
    ln("    syscall")
    ln("")
    nat64 top = ast_a[prog]
    nat64 cur = ast_list_first(top)
    rep cur != 0 {
        if ast_kind[cur] == TOK_ND_CONST {
            con_add(ast_name_ptr[cur], ast_name_len[cur], const_eval(ast_a[cur]))
        }
        cur = ast_next[cur]
    }
    cur = ast_list_first(top)
    rep cur != 0 {
        nat64 k = ast_kind[cur]
        if k == TOK_ND_GLOBALVAR {
            glb_add(ast_name_ptr[cur], ast_name_len[cur], ast_a[cur], ast_d[cur], 0)
            gen_global(cur, type_size(ast_a[cur], ast_d[cur]))
        }
        if k == TOK_ND_ARRDECL {
            if is_nib_type(ast_a[cur]) == 1 {
                nib_add(ast_name_ptr[cur], ast_name_len[cur], ast_a[cur] == TOK_INT4)
                glb_add(ast_name_ptr[cur], ast_name_len[cur], ast_a[cur], 0, 1)
                gen_global(cur, (ast_d[cur] + 15) / 16 * 8)
            } else {
                glb_add(ast_name_ptr[cur], ast_name_len[cur], ast_a[cur], 0, 1)
                gen_global(cur, ast_d[cur] * type_size(ast_a[cur], 0))
            }
        }
        cur = ast_next[cur]
    }
    nib_global = nib_count
    cur = ast_list_first(top)
    rep cur != 0 {
        if ast_kind[cur] == TOK_ND_FUNC {
            gen_func(cur)
        }
        cur = ast_next[cur]
    }
    ret 0
}